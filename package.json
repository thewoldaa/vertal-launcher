{
  "name": "vertal-launcher",
  "productName": "Vertal Launcher",
  "version": "1.0.0",
  "description": "Offline-first Minecraft launcher - vanilla, Fabric, Quilt, Forge & NeoForge, no Microsoft account required, no ads, fully client-side.",
  "author": "CraftKal",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "^0.5.10"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "id.craftkal.vertal",
    "productName": "Vertal Launcher",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "app/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Game"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "afterPack": "scripts/after-pack.js"
  }
}